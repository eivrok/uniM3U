{
  "name": "unim3u",
  "version": "1.3.0",
  "description": "UniM3U — a fast M3U IPTV player",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.16",
    "mpegts.js": "^1.8.0"
  },
  "build": {
    "appId": "com.eivind.unim3u",
    "productName": "UniM3U",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "extraResources": [
      "THIRD-PARTY-LICENSES.txt"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  }
}
